# Docker-only template. Fill these in locally; never commit .env.
# Use a long random hexadecimal value for DB_PASSWORD so it is URL-safe.
# On an EXISTING installation retain the original DB_PASSWORD.
DB_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Compose supplies the database connection and matching auth variables internally.
# No hosted credentials, email API credentials or administrator passwords are included.
